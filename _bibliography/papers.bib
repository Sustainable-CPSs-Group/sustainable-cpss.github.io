@comment{
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
How to add a paper.

Copy one of the entries below and edit it. al-folio-specific fields, none of
them required:
  abbr        short venue badge shown on the left; colour comes from _data/venues.yml
  selected    {true} pins the paper to the "selected publications" list on the home page
              (_pages/about.md must also have selected_papers: true)
  preview     image filename inside assets/img/publication_preview/
  pdf         a filename inside assets/pdf/, or a full URL
  bibtex_show {true} adds a button that reveals the raw BibTeX
  award       a short string rendered as a highlighted badge, e.g. {Best Paper Award}

Do NOT use % line comments inside an entry: the BibTeX parser does not treat %
as a comment marker and will try to parse whatever follows.

Neither paper below has a DOI yet. Once IEEE Xplore assigns them, add a
  doi = {10.1109/...},
line to the entry. Add a pdf field only if the publisher's policy allows it;
both papers are IEEE-copyrighted, so we link to Xplore rather than host the PDF.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
}

@article{gaiardelli2026budget,
  title    = {Budget-Conditioned {BLE} Communication for Federated Reactors},
  author   = {Gaiardelli, Sebastiano and Kindt, Philipp H. and Chakraborty, Samarjit},
  journal  = {IEEE Embedded Systems Letters},
  year     = {2026},
  note     = {Special issue for the Workshop on Time-Centric Reactive Software (TCRS)},
  abbr     = {ESL},
  preview  = {ble-federated-reactors.png},
  bibtex_show = {true},
  selected = {true},
  abstract = {Lingua Franca is a coordination language for building deterministic
              concurrent software using components called reactors. Federated reactors
              carry this determinism across distributed nodes, and a federation keeps
              its deterministic timing as long as every link obeys a maximum latency,
              called maxwait, specified at design time. Lingua Franca's runtime for
              microcontroller-class devices already carries federations over wired links
              and over IP, but not over a low-power radio, whose probabilistic behaviour
              makes the selection of maxwait non-trivial. We close this gap by adopting a
              connection-oriented Bluetooth Low Energy link, which is itself a
              time-triggered protocol. We derive a closed-form latency bound accounting
              for the worst-case number of retransmissions needed to reach a given target
              reliability, establish a method to synthesize BLE configurations that satisfy
              a specified maxwait, and present an implementation in Reactor-UC.}
}

@inproceedings{kindt2026predictive,
  title     = {Demo: Predictive Maintenance without Maintenance},
  author    = {Kindt, Philipp H. and Gaiardelli, Sebastiano and Caccamo, Marco and
               Wild, Thomas and Herkersdorf, Andreas and Chakraborty, Samarjit},
  booktitle = {IEEE International Conference on Embedded and Real-Time Computing Systems and Applications (RTCSA)},
  year      = {2026},
  abbr      = {RTCSA},
  preview   = {predictive-maintenance.png},
  bibtex_show = {true},
  selected  = {true},
  abstract  = {Predictive maintenance becomes self-defeating when the sensors used to
               avoid machine maintenance require maintenance themselves. This paper
               outlines a path toward maintenance-free predictive maintenance using
               batteryless, retrofittable nodes that harvest ambient energy, monitor
               vibration, sound and temperature, and communicate only when local
               behaviour changes or when an AI or human diagnostic task needs evidence.
               We propose a cross-layer architecture with energy-adaptive local
               inference, semantic anomaly summaries, asynchronous neighbor
               discovery-style communication, and optional receiver-directed grants for
               dense deployments. A fan-vibration case study shows that a taped-on sensor
               can detect small mechanical changes.}
}
