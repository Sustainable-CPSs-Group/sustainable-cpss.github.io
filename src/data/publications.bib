@article{gaiardelli2026budget,
  title = {Budget-Conditioned {BLE} Communication for Federated Reactors},
  author = {Gaiardelli, Sebastiano and Kindt, Philipp H. and Chakraborty, Samarjit},
  journal = {IEEE Embedded Systems Letters},
  year = {2026},
  note = {Special issue for the Workshop on Time-Centric Reactive Software (TCRS)},
  abbr = {ESL},
  preview = {ble-federated-reactors.png},
  selected = {true},
  abstract = {Lingua Franca is a coordination language for building deterministic concurrent software using components called reactors. Federated reactors carry this determinism across distributed nodes, and a federation keeps its deterministic timing as long as every link obeys a maximum latency, called maxwait, specified at design time.}
}

@inproceedings{kindt2026predictive,
  title = {Demo: Predictive Maintenance without Maintenance},
  author = {Kindt, Philipp H. and Gaiardelli, Sebastiano and Caccamo, Marco and Wild, Thomas and Herkersdorf, Andreas and Chakraborty, Samarjit},
  booktitle = {IEEE International Conference on Embedded and Real-Time Computing Systems and Applications (RTCSA)},
  year = {2026},
  abbr = {RTCSA},
  preview = {predictive-maintenance.png},
  selected = {true},
  abstract = {Predictive maintenance becomes self-defeating when the sensors used to avoid machine maintenance require maintenance themselves. This paper outlines a path toward maintenance-free predictive maintenance using batteryless, retrofittable nodes that harvest ambient energy.}
}
