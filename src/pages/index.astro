---
import { getCollection, getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PublicationList from "../components/PublicationList.astro";
import { parseBibtex } from "../lib/bibtex";
import publicationsRaw from "../data/publications.bib?raw";

const about = await getEntry("pages", "about");
if (!about) throw new Error("Missing about page content");
const { Content } = await render(about);
const posts = (await getCollection("posts")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 2);
const news = (await getCollection("news")).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const selectedPublications = parseBibtex(publicationsRaw).filter((entry) => entry.fields.selected === "true");
const pillars = [
  ["01", "Batteryless operation", "Push energy budgets toward harvested power without abandoning timing guarantees."],
  ["02", "Lightweight safe autonomy", "Use smaller learned components inside architectures with verifiable safety envelopes."],
  ["03", "Edge-first computing", "Keep evidence and decisions near the physical process instead of moving raw data."],
  ["04", "Self-adapting systems", "Detect degradation early and reconfigure before inefficiency becomes failure."],
];
---
<BaseLayout>
  <section class="hero">
    <div class="shell hero-inner">
      <div class="hero-copy">
        <p class="eyebrow">TUM Institute for Advanced Study · Focus Group</p>
        <h1>Systems that <em>endure.</em></h1>
        <p>We research cyber-physical systems that are sustainable to build, operate, and maintain—from harvested-energy sensors to safe, adaptive edge intelligence.</p>
        <div class="button-row">
          <a class="button" href="/research/">Explore the research <span aria-hidden="true">→</span></a>
          <a class="button secondary" href="/people/">Meet the group</a>
        </div>
      </div>
      <div class="system-orbit" aria-label="Four connected research directions surrounding Sustainable CPS">
        <span class="ring" style="--n: 0"></span><span class="ring" style="--n: 1"></span><span class="ring" style="--n: 2"></span><span class="ring" style="--n: 3"></span>
        <span class="node">Harvested<br />power</span><span class="node">Safe<br />autonomy</span><span class="node">Edge<br />intelligence</span><span class="node">Early<br />warning</span>
        <span class="core">S·CPS</span>
      </div>
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div><p class="eyebrow">Research agenda</p><h2>Less energy.<br />More assurance.</h2></div>
      <div class="prose"><Content /></div>
    </div>
    <div class="pillars">
      {pillars.map(([number, title, copy]) => <article class="pillar"><span class="number">{number}</span><h3>{title}</h3><p>{copy}</p><a href="/research/">Read the agenda →</a></article>)}
    </div>
  </section>

  <section class="section band-dark">
    <div class="shell">
      <div class="section-heading">
        <div><p class="eyebrow">Selected work</p><h2>Current results</h2></div>
        <p>Our publications are maintained in a single BibTeX file. Add a record once and it appears here and in the complete bibliography.</p>
      </div>
      <PublicationList entries={selectedPublications} compact />
    </div>
  </section>

  <section class="section shell">
    <div class="section-heading">
      <div><p class="eyebrow">From the group</p><h2>Research updates</h2></div>
      <p>Notes on papers, prototypes, methods, and the systems questions behind them.</p>
    </div>
    <div class="post-grid">
      {posts.map((post) => <a class="post-card" href={`/blog/${post.data.date.getUTCFullYear()}/${post.id.replace(/^\d{4}-\d{2}-\d{2}-/, "")}/`}>{post.data.hero && <img src={post.data.hero} alt={post.data.heroAlt || ""} loading="lazy" />}<div class="post-body"><time datetime={post.data.date.toISOString()}>{post.data.date.toLocaleDateString("en", { dateStyle: "medium" })}</time><h2>{post.data.title}</h2><p>{post.data.description}</p><span class="read">Read update →</span></div></a>)}
    </div>
  </section>

  <section class="section band-dark">
    <div class="shell">
      <div class="section-heading"><div><p class="eyebrow">Signals</p><h2>Latest news</h2></div><p>Milestones from the Focus Group and its collaborators.</p></div>
      <div class="news-list">
        {news.map((item) => <a class="news-item" href={item.data.link || "/blog/"}><time datetime={item.data.date.toISOString()}>{item.data.date.toLocaleDateString("en", { year: "numeric", month: "short", day: "numeric" })}</time><p>{item.data.title}</p><span aria-hidden="true">→</span></a>)}
      </div>
    </div>
  </section>
</BaseLayout>
